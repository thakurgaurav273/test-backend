# --- App ---
NODE_ENV=development
PORT=4000
# Public URL of this API (used for local upload URLs and the CSRF origin check)
APP_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API (website + admin panel)
CORS_ORIGINS=http://localhost:3000
# Set to 1 (or true) when running behind a reverse proxy / load balancer so rate limiting sees real client IPs
TRUST_PROXY=false
# Swagger UI at /api/docs. Defaults to on outside production.
SWAGGER_ENABLED=true

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zoycoders?schema=public

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN_HOURS=24
# lax when the admin panel shares the API's site; none (HTTPS only) when they are on different domains
COOKIE_SAMESITE=lax

# --- First admin (used by `npm run db:seed`) ---
ADMIN_EMAIL=admin@zoycoders.com
ADMIN_PASSWORD=
ADMIN_NAME=ZoyCoders Admin

# --- Uploads ---
UPLOAD_MAX_SIZE_MB=5
# Without Cloudinary credentials, files are stored in UPLOAD_DIR and served from /uploads
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (inquiry replies). For local testing use Mailtrap or Ethereal SMTP credentials. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ZoyCoders <hello@zoycoders.com>"
# Optional: address that gets notified about every new inquiry
INQUIRY_NOTIFY_EMAIL=
